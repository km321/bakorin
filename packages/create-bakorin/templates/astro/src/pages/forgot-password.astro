---
import Layout from "../layouts/Base.astro";
import ForgotPasswordForm from "@bakorin/sdk/astro/ForgotPasswordForm.astro";
import { handleAuthForm } from "@bakorin/sdk/astro";
import { bakorinUrl } from "../lib/bakorin.ts";

const result = await handleAuthForm(Astro, { baseUrl: bakorinUrl(), mode: "forgot" });
---
<Layout title="Forgot password">
  <section class="card">
    <h1>Forgot password</h1>
    <p class="lede">If that email exists, Bakorin sends a reset link. Check the API logs when MAIL_DRIVER=log.</p>
    <ForgotPasswordForm signInHref="/login" result={result} />
  </section>
</Layout>
