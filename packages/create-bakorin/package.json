{
  "name": "create-bakorin",
  "version": "0.1.0-beta.0",
  "description": "Scaffold a Bakorin backend and an optional Astro or Next.js starter",
  "license": "MIT",
  "author": "Melton Studios",
  "type": "module",
  "bin": {
    "create-bakorin": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "bun": "./src/cli.ts",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "src",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --target node --format esm && bun -e \"await Bun.write('dist/cli.d.ts', 'export {};\\n')\"",
    "prepublishOnly": "bun run build"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/km321/bakorin.git",
    "directory": "packages/create-bakorin"
  },
  "bugs": {
    "url": "https://github.com/km321/bakorin/issues"
  },
  "homepage": "https://bakorin-preview.pages.dev/docs/",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "bakorin",
    "create",
    "scaffold",
    "starter",
    "template",
    "astro",
    "next"
  ]
}
