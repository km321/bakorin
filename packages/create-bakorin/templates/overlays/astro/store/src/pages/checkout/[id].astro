---
import Layout from "../../layouts/Base.astro";
import { api } from "../../lib/bakorin.ts";
import { money, orderLines, orderNumber, STATUS_LABELS } from "../../lib/store.ts";

const order = await api(Astro).entity("orders").get(String(Astro.params.id)).catch(() => null);
if (!order) {
  return new Response("Not found", { status: 404 });
}
const lines = orderLines(order);
// hooks.ts fills lines and totalCents right after the order is saved, then opens Stripe Checkout.
const ready = order.totalCents !== undefined && order.totalCents !== null;
const backFromStripe = Astro.url.searchParams.get("paid") === "1";
---
<Layout title={`Order ${orderNumber(order.id)}`}>
  <section class="card">
    <h1>Order {orderNumber(order.id)}</h1>
    <p class="meta">{STATUS_LABELS[order.status] ?? order.status}</p>
    {ready ? (
      <>
        <table class="rows">
          <caption class="bk-visually-hidden">Items in this order</caption>
          <thead>
            <tr><th scope="col">Product</th><th scope="col">Quantity</th><th scope="col">Price</th></tr>
          </thead>
          <tbody>
            {lines.map((line) => (
              <tr><td data-label="Product">{line.name}</td><td data-label="Quantity">{line.quantity}</td><td data-label="Price">{money(line.unitCents)}</td></tr>
            ))}
          </tbody>
        </table>
        <p><strong>Total: {money(order.totalCents)}</strong></p>
      </>
    ) : (
      <p class="notice" role="status">Adding up your order. <a href={Astro.url.pathname}>Refresh</a> in a moment.</p>
    )}
  </section>

  <section class="card" aria-labelledby="payment-heading">
    <h2 id="payment-heading">Payment</h2>
    {order.status === "paid" ? (
      <p class="notice" role="status"><strong>Paid.</strong> Thank you. A receipt is on its way to {order.email}.</p>
    ) : order.status === "cancelled" ? (
      <p class="notice">{order.note || "This order was cancelled."}</p>
    ) : backFromStripe ? (
      <p class="notice" role="status">Thanks. We are confirming your payment with Stripe. <a href={Astro.url.pathname + "?paid=1"}>Refresh</a> in a moment.</p>
    ) : order.note ? (
      <p class="notice">{order.note}</p>
    ) : order.checkoutUrl ? (
      <>
        <p>You will pay on Stripe's secure checkout page, then come back here.</p>
        <p><a class="button" href={order.checkoutUrl}>Pay {money(order.totalCents)} with Stripe</a></p>
      </>
    ) : (
      <p class="notice" role="status">Opening checkout. <a href={Astro.url.pathname}>Refresh</a> in a moment.</p>
    )}
  </section>
  <p><a href="/orders">See all your orders</a></p>
</Layout>
