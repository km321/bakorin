{
  "name": "bakorin",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "test:sqlite": "bun test",
    "test:postgres": "BAKORIN_TEST_DIALECT=postgres bun test",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/admin-ui/tsconfig.json",
    "build:ui": "bun run --filter @bakorin/admin-ui build && bun scripts/embed-ui.ts",
    "build:bin": "bun run build:ui && bun build --compile --minify --outfile bakorin packages/server/src/cli.ts",
    "build:packages": "bun run --filter @bakorin/core build && bun run --filter @bakorin/sdk build && bun run --filter @bakorin/server build && bun run --filter create-bakorin build",
    "pack:check": "bun scripts/npm-pack-check.ts",
    "release": "bun scripts/release.ts",
    "dev": "bun packages/server/src/cli.ts dev",
    "start": "bun packages/server/src/cli.ts start",
    "create": "bun packages/create-bakorin/src/cli.ts",
    "bakorin": "bun packages/server/src/cli.ts",
    "bench": "bun scripts/bench-sqlite.ts",
    "restore-drill": "bun scripts/restore-drill.ts",
    "build:sdk": "bun run --filter @bakorin/sdk build",
    "build:create": "bun run --filter create-bakorin build",
    "load:realtime": "bun scripts/realtime-load/run.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/km321/bakorin.git"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "license": "AGPL-3.0-only",
  "author": "Melton Studios",
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.1",
    "bun-types": "^1.2.5",
    "openapi-schema-validator": "^12.1.3",
    "playwright": "^1.65.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.8.2"
  }
}
