---
import Layout from "../layouts/Base.astro";

// src/middleware.ts loads the user on every page that has a session cookie.
if (Astro.locals.user) {
  return Astro.redirect("/app");
}
---
<Layout title="Home">
  <section class="card">
    <h1>Your data, on your host</h1>
    <p class="lede">This starter talks to a Bakorin API for signup, sign in, password reset, invites, and a private task list.</p>
    <div class="actions">
      <a class="button" href="/signup">Create an account</a>
      <a class="button secondary" href="/login">Sign in</a>
    </div>
  </section>
</Layout>
