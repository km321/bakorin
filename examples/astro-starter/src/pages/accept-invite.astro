---
import Layout from "../layouts/Base.astro";
import { api } from "../lib/bakorin.ts";

const token = Astro.url.searchParams.get("token") ?? "";
let error = "";
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  try {
    await api(Astro).acceptInvite({
      token: String(form.get("token") ?? ""),
      password: String(form.get("password") ?? ""),
      name: String(form.get("name") ?? "") || undefined,
    });
    return Astro.redirect("/app");
  } catch (err) {
    error = err instanceof Error ? err.message : "Could not accept the invite";
  }
}
---
<Layout title="Accept invite">
  <section class="card">
    <h1>Accept invite</h1>
    <p class="lede">Set your name and password to join this Bakorin app.</p>
    {error ? <div class="error" role="alert">{error}</div> : null}
    <form method="post">
      <input type="hidden" name="token" value={token} />
      <label>
        Name
        <input type="text" name="name" autocomplete="name" />
      </label>
      <label>
        Password
        <input type="password" name="password" autocomplete="new-password" minlength="8" required />
      </label>
      <div class="actions">
        <button type="submit">Join</button>
      </div>
    </form>
  </section>
</Layout>
