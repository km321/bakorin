---
import Layout from "../layouts/Base.astro";
import ResetPasswordForm from "@bakorin/sdk/astro/ResetPasswordForm.astro";
import { handleAuthForm } from "@bakorin/sdk/astro";
import { bakorinUrl } from "../lib/bakorin.ts";

// The token stays in the page URL, so the form posts back with it.
const result = await handleAuthForm(Astro, { baseUrl: bakorinUrl(), mode: "reset" });
---
<Layout title="Reset password">
  <section class="card">
    <h1>Reset password</h1>
    <p class="lede">Choose a new password of at least 8 characters.</p>
    <ResetPasswordForm result={result} />
    {result.message && <p><a href="/login">Sign in</a> with the new password.</p>}
  </section>
</Layout>
