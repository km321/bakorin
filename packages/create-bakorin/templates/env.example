# Required for bakorin start: 32+ random characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_SECRET_PREVIOUS=
PORT=4371
BAKORIN_DATA_DIR=
BAKORIN_ENV=
NODE_ENV=
# 1 behind one proxy such as Railway, or a comma list of proxy CIDRs. Empty trusts no proxy.
TRUST_PROXY=
# Shared with your Astro or Next site (same value on both). 32+ random characters.
# The site's pass through route and server calls send it with the visitor IP, so
# lockouts and rate limits apply per visitor. Generate one with: openssl rand -base64 48
BAKORIN_PROXY_SECRET=
DATABASE_URL=
APP_URL=http://localhost:4321
CORS_ORIGINS=http://localhost:4321,http://localhost:3000
BAKORIN_ADMIN_EMAIL=
BAKORIN_ADMIN_PASSWORD=
BAKORIN_ADMIN_NAME=
MAIL_DRIVER=log
MAIL_FROM=my-app <noreply@localhost>
# Placeholder only. Paste a Resend API key locally. Never commit a real key.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
BUCKET=
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_ADDRESSING_STYLE=path
S3_FORCE_PATH_STYLE=true
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
