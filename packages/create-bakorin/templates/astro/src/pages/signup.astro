---
import Layout from "../layouts/Base.astro";
import SignUpForm from "@bakorin/sdk/astro/SignUpForm.astro";
import { handleAuthForm } from "@bakorin/sdk/astro";
import { bakorinUrl, schema } from "../lib/bakorin.ts";

// Signup never signs you in and answers the same way for a new or a taken email.
const result = await handleAuthForm(Astro, { baseUrl: bakorinUrl(), mode: "sign-up" });
---
<Layout title="Create account">
  <section class="card">
    <h1>Create account</h1>
    <p class="lede">Use an email and a password of at least 8 characters. Check the API logs for the email when MAIL_DRIVER=log.</p>
    <SignUpForm schema={schema} signInHref="/login" result={result} />
  </section>
</Layout>
