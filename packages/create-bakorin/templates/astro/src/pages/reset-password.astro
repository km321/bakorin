---
import Layout from "../layouts/Base.astro";
import { api } from "../lib/bakorin.ts";

const token = Astro.url.searchParams.get("token") ?? "";
let error = "";
let done = false;
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  try {
    await api(Astro.cookies).resetPassword({
      token: String(form.get("token") ?? ""),
      password: String(form.get("password") ?? ""),
    });
    done = true;
  } catch (err) {
    error = err instanceof Error ? err.message : "Could not reset the password";
  }
}
---
<Layout title="Reset password">
  <section class="card">
    <h1>Reset password</h1>
    {done ? (
      <p>Password updated. <a href="/login">Sign in</a> with the new password.</p>
    ) : (
      <>
        <p class="lede">Choose a new password of at least 8 characters.</p>
        {error ? <div class="error" role="alert">{error}</div> : null}
        <form method="post">
          <input type="hidden" name="token" value={token} />
          <label>
            New password
            <input type="password" name="password" autocomplete="new-password" minlength="8" required />
          </label>
          <div class="actions">
            <button type="submit">Update password</button>
          </div>
        </form>
      </>
    )}
  </section>
</Layout>
