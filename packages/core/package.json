{
  "name": "@bakorin/core",
  "version": "0.0.1",
  "description": "app.yaml compiler, schema AST, and migrator diff for Bakorin",
  "license": "AGPL-3.0-only",
  "author": "Melton Studios",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --format esm --target node --packages external && bunx tsc -p tsconfig.json --emitDeclarationOnly --declaration --allowImportingTsExtensions",
    "prepublishOnly": "bun run build"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/km321/bakorin.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/km321/bakorin/issues"
  },
  "homepage": "https://github.com/km321/bakorin/tree/main/packages/core#readme",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "bakorin",
    "baas",
    "schema"
  ],
  "dependencies": {
    "yaml": "^2.7.1",
    "zod": "^4.6.7"
  }
}
