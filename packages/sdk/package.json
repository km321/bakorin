{
  "name": "@bakorin/sdk",
  "version": "0.0.1",
  "description": "Typed client for a Bakorin API, with Astro and Next.js helpers",
  "license": "MIT",
  "author": "Melton Studios",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.js",
      "bun": "./src/astro.ts",
      "default": "./dist/astro.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "bun": "./src/next.ts",
      "default": "./dist/next.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/astro.ts src/next.ts --outdir dist --format esm --target node && bunx tsc -p tsconfig.json --emitDeclarationOnly --declaration --allowImportingTsExtensions",
    "prepublishOnly": "bun run build"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/km321/bakorin.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/km321/bakorin/issues"
  },
  "homepage": "https://github.com/km321/bakorin/tree/main/packages/sdk#readme",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "bakorin",
    "sdk",
    "astro",
    "next"
  ]
}
