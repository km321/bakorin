---
import Layout from "../layouts/Base.astro";
import RichText from "@bakorin/sdk/astro/RichText.astro";
import { api } from "../lib/bakorin.ts";
import { planPrice, TIER_LABELS, type Plan } from "../lib/membership.ts";

// Plans are public in app.yaml, so this works signed out too.
const { data: plans } = await api(Astro).entity("plans").list({ filter: { active: true }, sort: "sort", limit: 12 });
const user = Astro.locals.user;
---
<Layout title="Plans">
  <section class="section">
    <h1>Become a member</h1>
    <p>Members read the lessons. Pro members also get the masterclasses.</p>
    {plans.length === 0 ? (
      <p class="empty">No plans yet. Admins can add them in /admin on the API, or run bun seed.ts for example plans.</p>
    ) : (
      <ul class="grid">
        {plans.map((plan: Plan) => (
          <li class="tile">
            <div class="tile-body">
              <h2>{plan.name}</h2>
              <p class="meta">{planPrice(plan)}</p>
              {plan.description ? <RichText html={plan.description} class="prose" /> : null}
              {user?.role === plan.tier ? (
                <p class="notice">This is your plan.</p>
              ) : (
                <form method="get" action={`/join/${plan.id}`}>
                  <button type="submit">Join {TIER_LABELS[plan.tier] ?? plan.tier}</button>
                </form>
              )}
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>
</Layout>
