---
import AuthForm from "./AuthForm.astro";
import { escapeHtml } from "../dist/astro-render.js";

interface Props {
  signInHref?: string;
  basePath?: string;
  result?: { errors?: Record<string, string>; error?: string; message?: string; values?: Record<string, unknown> };
}
const { signInHref, basePath, result } = Astro.props;
---

<AuthForm
  mode="forgot"
  fields={[{ name: "email", type: "email", required: true }]}
  submitLabel="Send reset link"
  className="bk-forgot"
  basePath={basePath}
  result={result}
  footer={signInHref ? `<p class="bk-links"><a href="${escapeHtml(signInHref)}">Back to sign in</a></p>` : undefined}
/>
