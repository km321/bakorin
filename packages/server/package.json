{
  "name": "@bakorin/server",
  "version": "0.1.0-beta.0",
  "description": "Self-hosted Bakorin API: auth, CRUD, files, admin UI, and the bakorin CLI",
  "license": "AGPL-3.0-only",
  "author": "Melton Studios",
  "type": "module",
  "bin": {
    "bakorin": "./dist/cli.js"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --outfile dist/cli.js --target bun --format esm",
    "prepublishOnly": "bun run build"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/km321/bakorin.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/km321/bakorin/issues"
  },
  "homepage": "https://bakorin-preview.pages.dev/docs/",
  "engines": {
    "bun": ">=1.1.0"
  },
  "keywords": [
    "bakorin",
    "baas",
    "backend",
    "api",
    "rest",
    "auth",
    "sqlite",
    "postgres",
    "hono",
    "bun",
    "self-hosted"
  ],
  "dependencies": {
    "@bakorin/core": "workspace:^",
    "hono": "^4.7.4",
    "jose": "^6.0.10",
    "kysely": "^0.28.2",
    "pg": "^8.14.1",
    "swagger-ui-dist": "^5.35.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11"
  }
}
