{
  "name": "@bakorin/sdk",
  "version": "0.0.1",
  "description": "Typed client for a Bakorin API, with Astro and Next.js helpers, headless stores, React hooks, and components",
  "license": "MIT",
  "author": "Melton Studios",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.js",
      "bun": "./src/astro.ts",
      "default": "./dist/astro.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "bun": "./src/next.ts",
      "default": "./dist/next.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "bun": "./src/browser.ts",
      "default": "./dist/browser.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "import": "./dist/proxy.js",
      "bun": "./src/proxy.ts",
      "default": "./dist/proxy.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js",
      "bun": "./src/headless.ts",
      "default": "./dist/headless.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "bun": "./src/react.ts",
      "default": "./dist/react.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "import": "./dist/elements.js",
      "bun": "./src/elements.ts",
      "default": "./dist/elements.js"
    },
    "./astro-render": {
      "types": "./dist/astro-render.d.ts",
      "import": "./dist/astro-render.js",
      "bun": "./src/astro-render.ts",
      "default": "./dist/astro-render.js"
    },
    "./astro/*": "./astro/*",
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "src",
    "astro",
    "styles.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepublishOnly": "bun run build"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/km321/bakorin.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/km321/bakorin/issues"
  },
  "homepage": "https://github.com/km321/bakorin/tree/main/packages/sdk#readme",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "bakorin",
    "sdk",
    "astro",
    "astro-component",
    "next",
    "react"
  ],
  "sideEffects": [
    "./dist/elements.js",
    "./src/elements.ts",
    "./src/elements/index.ts",
    "./styles.css",
    "*.astro",
    "./dist/chunks/*.js"
  ],
  "peerDependencies": {
    "react": ">=18",
    "astro": ">=4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "astro": {
      "optional": true
    }
  }
}
