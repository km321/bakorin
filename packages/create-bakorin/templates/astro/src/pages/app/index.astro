---
import Layout from "../../layouts/Base.astro";
import Gate from "@bakorin/sdk/astro/Gate.astro";
import LiveList from "@bakorin/sdk/astro/LiveList.astro";
import FileUpload from "@bakorin/sdk/astro/FileUpload.astro";
import { api, schema } from "../../lib/bakorin.ts";

// src/middleware.ts already checked the session, so Astro.locals.user is set here.
const user = Astro.locals.user!;
---
<Layout title="Dashboard">
  <section class="card">
    <h1>Hello, {user.name}</h1>
    <p class="lede">This page is protected by requireAuth in src/middleware.ts.</p>
    <Gate roles={["admin"]}>
      <p class="banner">You are an admin. Open the Bakorin admin at /admin on the API.</p>
      <p slot="fallback">Your role is {user.role}. Admin only content stays hidden.</p>
    </Gate>
  </section>

  <section class="card">
    <h2>Latest tasks</h2>
    <p class="lede">This list follows realtime changes. Add a task on the <a href="/app/tasks">tasks page</a> in another tab.</p>
    <LiveList client={api(Astro)} entity="tasks" schema={schema} sort="-createdAt" limit={5} label="Latest tasks" />
  </section>

  <section class="card">
    <h2>Upload a file</h2>
    <p class="lede">Files go through /api/bakorin with your session cookie and come back as a signed link.</p>
    <FileUpload accept="image/*,application/pdf,text/plain" maxBytes={10485760} />
  </section>
</Layout>
