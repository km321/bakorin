---
/**
 * Renders the default slot for signed in users and the "fallback" slot otherwise.
 * It hides UI; Bakorin's policies protect the data and requireAuth protects pages.
 */
interface Props {
  user?: Record<string, unknown> | null;
  roles?: string[];
}
const user = (Astro.props.user === undefined ? Astro.locals.user : Astro.props.user) as { role?: unknown } | null | undefined;
const roles = Astro.props.roles;
const allowed = Boolean(user) && (!roles || roles.includes(String(user?.role)));
---

{allowed ? <slot /> : <slot name="fallback" />}
