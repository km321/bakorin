---
import { paragraphs, type Section } from "../lib/sections.ts";

interface Props {
  sections: Section[];
  /** Admins see a hint when a page has no sections yet. */
  emptyText: string;
}
const { sections, emptyText } = Astro.props;
---
{sections.length === 0 ? (
  <section class="card">
    <p class="empty">{emptyText}</p>
  </section>
) : (
  sections.map((section, index) => (
    <section class="card" aria-labelledby={`section-${section.id}`}>
      {index === 0 ? <h1 id={`section-${section.id}`}>{section.heading}</h1> : <h2 id={`section-${section.id}`}>{section.heading}</h2>}
      {paragraphs(section.body).map((text) => <p>{text}</p>)}
      {section.ctaLabel && section.ctaHref ? (
        <div class="actions">
          <a class="button" href={section.ctaHref}>{section.ctaLabel}</a>
        </div>
      ) : null}
    </section>
  ))
)}
