---
import Layout from "../../layouts/Base.astro";
import Gate from "@bakorin/sdk/astro/Gate.astro";
import LiveList from "@bakorin/sdk/astro/LiveList.astro";
import RecordForm from "@bakorin/sdk/astro/RecordForm.astro";
import { handleRecordForm } from "@bakorin/sdk/astro";
import { formFields } from "@bakorin/sdk/headless";
import { api, bakorinUrl, schema } from "../../lib/bakorin.ts";
import { MANAGERS, STATUSES } from "../../lib/team.ts";

// requireAuth in src/middleware.ts protects /app, so the user is set.
const user = Astro.locals.user!;
const client = api(Astro);

const result = await handleRecordForm(Astro, {
  baseUrl: bakorinUrl(),
  entity: "updates",
  fields: formFields(schema.entities.updates, { include: ["message", "projectId"] }),
  redirectTo: "/app",
});
if (result.response) return result.response;

// One small request per status; the API answers with the total for each filter.
const counts = await Promise.all(
  STATUSES.map(async (status) => ({ status, total: (await client.entity("projects").list({ filter: { status }, limit: 1 })).meta.total })),
);
---
<Layout title="Dashboard">
  <section class="card">
    <h1>Hello, {user.name}</h1>
    <Gate user={user} roles={MANAGERS}>
      <p class="banner">You are a {user.role}. You can edit and delete any project, and admins see the Team page.</p>
      <p slot="fallback" class="lede">You can add projects and edit the ones you own. A manager or admin can change the rest.</p>
    </Gate>
    <dl class="facts">
      {counts.map((count) => (
        <Fragment>
          <dt>{count.status[0]!.toUpperCase() + count.status.slice(1)}</dt>
          <dd>{count.total} {count.total === 1 ? "project" : "projects"}</dd>
        </Fragment>
      ))}
    </dl>
    <a href="/app/projects">See all projects</a>
  </section>

  <div class="split section">
    <section class="card">
      <h2>Team updates</h2>
      <p class="lede">New updates show up here as your team posts them, in every open tab.</p>
      <LiveList client={client} entity="updates" schema={schema} sort="-createdAt" limit={8} label="Team updates" emptyText="No updates yet." />
    </section>
    <section class="card">
      <h2>Post an update</h2>
      <RecordForm
        entity="updates"
        schema={schema}
        include={["message", "projectId"]}
        client={client}
        labels={{ message: "Update", projectId: "Project (optional)" }}
        submitLabel="Post update"
        result={result}
      />
    </section>
  </div>
</Layout>
