{
  "name": "bakorin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "test:sqlite": "bun test",
    "test:postgres": "bun test tests/postgres.test.ts",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "build:ui": "bun run --filter @bakorin/admin-ui build && bun scripts/embed-ui.ts",
    "build:bin": "bun run build:ui && bun build --compile --minify --outfile bakorin packages/server/src/cli.ts",
    "release": "bun scripts/release.ts",
    "dev": "bun packages/server/src/cli.ts dev",
    "start": "bun packages/server/src/cli.ts start",
    "bakorin": "bun packages/server/src/cli.ts",
    "bench": "bun scripts/bench-sqlite.ts",
    "restore-drill": "bun scripts/restore-drill.ts",
    "build:sdk": "bun run --filter @bakorin/sdk build",
    "build:create": "bun run --filter create-bakorin build"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "license": "MIT",
  "author": "Melton Studios",
  "devDependencies": {
    "bun-types": "^1.2.5",
    "openapi-schema-validator": "^12.1.3",
    "typescript": "^5.8.2"
  }
}
