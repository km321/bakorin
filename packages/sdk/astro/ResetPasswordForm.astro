---
import AuthForm from "./AuthForm.astro";

interface Props {
  basePath?: string;
  result?: { errors?: Record<string, string>; error?: string; message?: string };
}
const { basePath, result } = Astro.props;
---

<AuthForm
  mode="reset"
  fields={[{ name: "password", type: "password", required: true }]}
  labels={{ password: "New password" }}
  submitLabel="Set new password"
  className="bk-reset"
  basePath={basePath}
  result={result}
/>
