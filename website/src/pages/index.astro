---
import { Image } from "astro:assets";
import Marketing from "../layouts/Marketing.astro";
import CodeBlock from "../components/CodeBlock.astro";
import projectsLight from "../assets/screens/admin-projects-light.webp";
import projectsDark from "../assets/screens/admin-projects-dark.webp";
import editorLight from "../assets/screens/admin-editor-light.webp";
import editorDark from "../assets/screens/admin-editor-dark.webp";
import schemaLight from "../assets/screens/admin-schema-light.webp";
import schemaDark from "../assets/screens/admin-schema-dark.webp";
import statusLight from "../assets/screens/admin-status-light.webp";
import statusDark from "../assets/screens/admin-status-dark.webp";
import mailLight from "../assets/screens/admin-mail-light.webp";
import mailDark from "../assets/screens/admin-mail-dark.webp";
import webhooksLight from "../assets/screens/admin-webhooks-light.webp";
import webhooksDark from "../assets/screens/admin-webhooks-dark.webp";
import jobsLight from "../assets/screens/admin-jobs-light.webp";
import jobsDark from "../assets/screens/admin-jobs-dark.webp";
import backupsLight from "../assets/screens/admin-backups-light.webp";
import backupsDark from "../assets/screens/admin-backups-dark.webp";
import brandedLight from "../assets/screens/admin-branded-light.webp";
import brandedDark from "../assets/screens/admin-branded-dark.webp";
import filesLight from "../assets/screens/admin-files-page-light.webp";
import filesDark from "../assets/screens/admin-files-page-dark.webp";
const heroYaml = `app:
  name: studio-leads

entities:
  users:
    auth: true
    fields:
      email: { type: email, unique: true, required: true }
      password: { type: password, required: true }
      name: { type: text, required: true }
      role: { type: enum, values: [user, admin], default: user }

  leads:
    display: company
    fields:
      company: { type: text, required: true }
      status: { type: enum, values: [new, won, lost], default: new }
      brief: { type: file }
      ownerId: { type: relation, to: users, required: true }
    policies:
      read: [owner(ownerId), admin]
      create: authenticated
      update: owner(ownerId)

webhooks:
  - entity: leads
    events: [create]
    url: \${WEBHOOK_URL}
    secret: \${WEBHOOK_SECRET}`;

const heroShell = `$ bun run create my-app --frontend astro --schema todo --yes
$ bun run dev -- --dir my-app
[bakorin] my-app dev on http://127.0.0.1:4371
[bakorin] admin UI http://127.0.0.1:4371/admin/`;

const astroSnippet = `// src/lib/bakorin.ts
import { createAstroClient } from "@bakorin/sdk/astro";

export const api = (cookies) =>
  createAstroClient({ baseUrl: import.meta.env.BAKORIN_URL, cookies });

// src/pages/app/index.astro (frontmatter)
const { data: tasks } = await api(Astro.cookies)
  .entity("tasks")
  .list({ sort: "-createdAt", limit: 50 });`;

const nextSnippet = `// lib/bakorin.ts
import { createNextClient } from "@bakorin/sdk/next";
import { cookies } from "next/headers";

export const api = async () =>
  createNextClient({ baseUrl: process.env.BAKORIN_URL!, cookies: await cookies() });

// app/app/page.tsx (Server Component)
const client = await api();
const { data: tasks } = await client.entity("tasks").list({ sort: "-createdAt" });`;

const features = [
  {
    title: "Data and relations",
    body: "Eleven field types, one to many and many to many relations, indexes, filters, sorting, and expand. Every entity gets a REST resource.",
    tag: "GET /api/v1/tasks?expand=leadId",
  },
  {
    title: "Auth that is already done",
    body: "Email and password with verification, password reset, and invites. Refresh token rotation, argon2id hashing, rate limits, and lockout.",
    tag: "POST /api/v1/auth/invites",
  },
  {
    title: "Permissions in plain words",
    body: "Per action policies like owner(ownerId), authenticated, role(editor), and admin. Field write locks keep roles and owners safe.",
    tag: "read: [owner(ownerId), admin]",
  },
  {
    title: "Files",
    body: "Uploads to local disk or any S3 compatible bucket, including R2 and Railway buckets. Size and type limits, short lived signed URLs, and a Files page that finds unused uploads.",
    tag: "POST /api/v1/files",
  },
  {
    title: "Webhooks you can trust",
    body: "A durable outbox, HMAC signatures over timestamp and body, retries with backoff, secret fields stripped, and a delivery log with retry.",
    tag: "x-bakorin-signature: sha256=",
  },
  {
    title: "Admin UI, light and dark",
    body: "Sortable, searchable tables, create and edit drawers, invites, files, backups, audit log, and webhooks. Generated from your schema.",
    tag: "/admin/",
  },
  {
    title: "Realtime, when you want it",
    body: "Turn on live updates per entity. Server sent events filtered by each reader's permissions, with resume, backpressure, and a Postgres broker for more than one instance.",
    tag: "realtime: true",
  },
  {
    title: "Many to many",
    body: "Link a record to any number of others with many: true. Arrays of ids in and out, expand, a has filter, and permission checks on every link.",
    tag: "tagIds: { type: relation, to: tags, many: true }",
  },
  {
    title: "MCP for AI tools",
    body: "An optional, read only MCP server lets Cursor or Claude read your schema, policies, API spec, and types while you build the front end.",
    tag: "POST /mcp",
  },
  {
    title: "Schema map",
    body: "See every entity and relation as a diagram in the admin, export SVG, or print Mermaid and JSON from the CLI.",
    tag: "bakorin schema --format mermaid",
  },
  {
    title: "Backups and moves",
    body: "Scheduled snapshots to a folder or S3 with retention, portable exports, and a documented path from SQLite to Postgres.",
    tag: "bakorin backup",
  },
];

const faqs = [
  {
    q: "Is Bakorin available to install today?",
    a: "Not publicly. Bakorin is in private beta, the repository is private, and the npm packages are not published yet. The install commands on this site show the intended usage.",
  },
  {
    q: "What does it run on?",
    a: "Bun. The server is built with Hono, Kysely, and Zod, and the admin UI is Preact. It compiles to a single binary with the admin embedded, or runs from a Docker image.",
  },
  {
    q: "SQLite or Postgres?",
    a: "SQLite by default, on a volume. Switch runtime.dialect to postgres when you need more than one instance. The same app.yaml works on both, and bakorin export and import move data between them.",
  },
  {
    q: "Do I have to use Astro or Next.js?",
    a: "No. The API is plain REST with a generated OpenAPI document. The SDK has cookie helpers for Astro and Next.js, and a generic client for anything that runs fetch.",
  },
  {
    q: "Can I add custom logic?",
    a: "Yes, in hooks.ts. You get before and after hooks for create, update, and delete on each entity, plus custom Hono routes. There is no plugin system on purpose.",
  },
  {
    q: "Does it do realtime?",
    a: "Yes, and it is off until you turn it on per entity. Clients get server sent events filtered by their own read permissions, resume after a disconnect, and work across instances on Postgres. The SDK has subscribe, and the Astro and Next.js starters use it for a live task list.",
  },
  {
    q: "How is it licensed?",
    a: "Open source with a split license: the server (server, core, and admin UI) is AGPL-3.0, and the SDK, create-bakorin, and the starters are MIT. Commercial licenses for the server are available from Melton Studios.",
    link: { href: "https://meltonstudios.com/contact/", label: "Contact Melton Studios" },
  },
  {
    q: "Many to many relations?",
    a: "Yes. Add many: true to a relation and the field holds an array of ids, with expand, a has filter, permission checks on every link, and a multi select picker in the admin. Bakorin keeps the join table for you.",
  },
  {
    q: "Where does my data live?",
    a: "Wherever you deploy it. Each project is one folder with one database, so every client can have their own backend on your own infrastructure.",
  },
];
---
<Marketing title="Bakorin: one app.yaml, a whole backend" description="Bakorin is a self-hosted backend for agencies and solopreneurs. One app.yaml gives you auth, data, files, permissions, webhooks, and an admin UI for Astro or Next.js sites.">
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span class="pulse" aria-hidden="true"></span>Private beta</p>
        <h1>One file.<br /><span class="accent">A whole backend.</span></h1>
        <p class="lede">
          Bakorin turns a single <code>app.yaml</code> into users, auth, data, files, permissions, webhooks, and an admin UI.
          Self-hosted, one binary, one database per project. Built for agencies and solopreneurs shipping Astro and Next.js sites.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href="/docs/getting-started/">Get started</a>
          <a class="btn btn-ghost" href="/builder/">Build an app.yaml</a>
        </div>
        <ul class="hero-points" aria-label="Highlights">
          <li>SQLite or Postgres</li>
          <li>Typed SDK</li>
          <li>AGPL-3.0 server, MIT SDK</li>
        </ul>
      </div>
      <div class="hero-code">
        <CodeBlock code={heroYaml} lang="yaml" title="app.yaml" />
        <CodeBlock code={heroShell} lang="shellsession" title="terminal" />
      </div>
    </div>
  </section>

  <section class="showcase" aria-label="Admin UI preview">
    <div class="wrap">
      <div class="browser">
        <div class="browser-bar" aria-hidden="true"><span class="dots"><i></i><i></i><i></i></span><span class="url">127.0.0.1:4371/admin/</span></div>
        <Image class="only-light" src={projectsLight} alt="Bakorin admin in light mode showing a Projects table with client, status, budget, due date, and tags columns" widths={[640, 1024, 1440]} sizes="(max-width: 1100px) 100vw, 1024px" loading="eager" />
        <Image class="only-dark" src={projectsDark} alt="Bakorin admin in dark mode showing a Projects table with client, status, budget, due date, and tags columns" widths={[640, 1024, 1440]} sizes="(max-width: 1100px) 100vw, 1024px" loading="eager" />
      </div>
      <p class="caption">The real admin UI, generated from a demo project's app.yaml. The studio and its clients are fictional.</p>
    </div>
  </section>

  <section id="how" class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">How it works</p>
        <h2>Describe it, run it, ship it.</h2>
        <p>Every client project is the same three things. Nothing to wire together.</p>
      </div>
      <ol class="steps">
        <li>
          <span class="step-num">01</span>
          <h3>One app.yaml</h3>
          <p>Entities, fields, relations, policies, auth settings, and webhooks in one readable file. Save it and <code>bakorin dev</code> reloads the schema without a restart.</p>
        </li>
        <li>
          <span class="step-num">02</span>
          <h3>One binary</h3>
          <p>The API, auth, file handling, webhooks worker, scheduled backups, and admin UI ship together. Run the compiled binary or the Docker image.</p>
        </li>
        <li>
          <span class="step-num">03</span>
          <h3>One database per project</h3>
          <p>SQLite on a volume to start, Postgres when you grow. Each client's data stays in its own folder you can back up, zip, and move.</p>
        </li>
      </ol>
    </div>
  </section>

  <section id="features" class="section section-alt">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">Features</p>
        <h2>The parts every client site ends up needing.</h2>
        <p>Built in, tested, and configured from the same file.</p>
      </div>
      <div class="feature-grid">
        {features.map((f) => (
          <article class="feature">
            <h3>{f.title}</h3>
            <p>{f.body}</p>
            <code class="feature-tag">{f.tag}</code>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <p class="kicker">Admin UI</p>
        <h2>An admin panel your clients can actually use.</h2>
        <p>Tables show names instead of ids, forms use your field descriptions as help text, and relations become searchable pickers, with chips for many to many links. Pick System, Light, or Dark.</p>
        <ul class="checks">
          <li>Create and edit in a side drawer</li>
          <li>Invite users and resend verification</li>
          <li>Live backups, audit log, and webhook deliveries</li>
          <li>Bundled API docs with Swagger UI</li>
        </ul>
        <a class="text-link" href="/docs/admin-ui/">Admin UI docs</a>
      </div>
      <div class="stack-shots">
        <div class="shot shot-back">
          <Image class="only-light" src={schemaLight} alt="Schema page in light mode with Client, Project, Task, Tag, and User cards and relation arrows, including many to many links from projects to tags and users" widths={[640, 1024]} sizes="(max-width: 900px) 100vw, 560px" />
          <Image class="only-dark" src={schemaDark} alt="Schema page in dark mode with Client, Project, Task, Tag, and User cards and relation arrows, including many to many links from projects to tags and users" widths={[640, 1024]} sizes="(max-width: 900px) 100vw, 560px" />
        </div>
        <div class="shot shot-front">
          <Image class="only-light" src={editorLight} alt="Edit Project drawer in light mode with a client picker, status select, and multi select chips for tags and members" widths={[640, 1024]} sizes="(max-width: 900px) 100vw, 560px" />
          <Image class="only-dark" src={editorDark} alt="Edit Project drawer in dark mode with a client picker, status select, and multi select chips for tags and members" widths={[640, 1024]} sizes="(max-width: 900px) 100vw, 560px" />
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="tour-title">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">Inside the admin</p>
        <h2 id="tour-title">Everything a handoff needs, already built.</h2>
        <p>Operations pages ship in the same binary. Screens are from a demo project with fictional data.</p>
      </div>
      <div class="tour-grid">
        <a class="tour-card" href="/docs/monitoring/">
          <div class="shot">
            <Image class="only-light" src={statusLight} alt="Status page with uptime, database, last backup, realtime open streams and broker, and email and webhook queues, light mode" widths={[480, 800]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 380px" />
            <Image class="only-dark" src={statusDark} alt="Status page with uptime, database, last backup, realtime open streams and broker, and email and webhook queues, dark mode" widths={[480, 800]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 380px" />
          </div>
          <h3>Status</h3>
          <p>Health, realtime streams, queues, and failed deliveries with Retry</p>
        </a>
        <a class="tour-card" href="/docs/email/">
          <div class="shot">
            <Image class="only-light" src={mailLight} alt="Mail page previewing a project shipped email rendered for a real project record, light mode" widths={[480, 800]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 380px" />
            <Image class="only-dark" src={mailDark} alt="Mail page previewing a project shipped email rendered for a real project record, dark mode" widths={[480, 800]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 380px" />
          </div>
          <h3>Mail preview</h3>
          <p>Preview a template against a real record, then send a test to yourself</p>
        </a>
        <a class="tour-card" href="/docs/webhooks/">
          <div class="shot">
            <Image class="only-light" src={webhooksLight} alt="Webhooks page listing delivered project events with status, attempts, and response codes, light mode" widths={[480, 800]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 380px" />
            <Image class="only-dark" src={webhooksDark} alt="Webhooks page listing delivered project events with status, attempts, and response codes, dark mode" widths={[480, 800]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 380px" />
          </div>
          <h3>Webhooks</h3>
          <p>Every delivery with its status, attempts, and response</p>
        </a>
        <a class="tour-card" href="/docs/jobs/">
          <div class="shot">
            <Image class="only-light" src={jobsLight} alt="Jobs page listing the daily digest job, a Run now button, and a history of successful runs, light mode" widths={[480, 800]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 380px" />
            <Image class="only-dark" src={jobsDark} alt="Jobs page listing the daily digest job, a Run now button, and a history of successful runs, dark mode" widths={[480, 800]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 380px" />
          </div>
          <h3>Jobs</h3>
          <p>Cron schedules, run history, and a button to run a job now</p>
        </a>
        <a class="tour-card" href="/docs/files/#files-page">
          <div class="shot">
            <Image class="only-light" src={filesLight} alt="Files page listing uploads with thumbnails, the record each file belongs to, and Preview, Download and Delete buttons, light mode" widths={[480, 800]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 380px" />
            <Image class="only-dark" src={filesDark} alt="Files page listing uploads with thumbnails, the record each file belongs to, and Preview, Download and Delete buttons, dark mode" widths={[480, 800]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 380px" />
          </div>
          <h3>Files</h3>
          <p>Every upload, the record it belongs to, and cleanup of unused files</p>
        </a>
        <a class="tour-card" href="/docs/backups/">
          <div class="shot">
            <Image class="only-light" src={backupsLight} alt="Backups page with a list of snapshots, their sizes, the restore command, and Download buttons, light mode" widths={[480, 800]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 380px" />
            <Image class="only-dark" src={backupsDark} alt="Backups page with a list of snapshots, their sizes, the restore command, and Download buttons, dark mode" widths={[480, 800]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 380px" />
          </div>
          <h3>Backups</h3>
          <p>Run a live backup and download any snapshot</p>
        </a>
        <a class="tour-card" href="/docs/branding/">
          <div class="shot">
            <Image class="only-light" src={brandedLight} alt="Admin branded as Fernwood Studio with a green leaf logo and green buttons, light mode" widths={[480, 800]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 380px" />
            <Image class="only-dark" src={brandedDark} alt="Admin branded as Fernwood Studio with a green leaf logo and green buttons, dark mode" widths={[480, 800]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 380px" />
          </div>
          <h3>Your client's brand</h3>
          <p>Their name, colors, and logo on the admin, docs, and emails</p>
        </a>
      </div>
    </div>
  </section>

  <section id="who" class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">Who it is for</p>
        <h2>For people who build sites for other people.</h2>
      </div>
      <div class="audience">
        <article>
          <h3>Agencies</h3>
          <p>Spin up a backend per client from the same pattern. Each project is a folder with its own database, so handoff, backups, and moving hosts stay simple. Clients get a clean admin instead of a database console.</p>
        </article>
        <article>
          <h3>Solopreneurs</h3>
          <p>Add logins, member areas, forms with file uploads, and a dashboard to an Astro or Next.js site without writing an API. The typed SDK and starters handle the session plumbing.</p>
        </article>
        <article class="muted-card">
          <h3>Maybe not for you yet</h3>
          <p>If you need a plugin ecosystem, GraphQL, or a hosted service someone else runs, Bakorin is not there. It is a small, self-hosted v0.1.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="quickstart" class="section section-alt">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">Quickstart</p>
        <h2>Talk to it from Astro or Next.js.</h2>
        <p>Cookie based sessions with httpOnly tokens and automatic refresh. Starters include signup, login, reset, invites, and a protected page.</p>
      </div>
      <div class="tabs" data-tabs>
        <div class="tablist" role="tablist" aria-label="Framework">
          <button role="tab" id="tab-astro" aria-controls="panel-astro" aria-selected="true" tabindex="0">Astro</button>
          <button role="tab" id="tab-next" aria-controls="panel-next" aria-selected="false" tabindex="-1">Next.js</button>
        </div>
        <div role="tabpanel" id="panel-astro" aria-labelledby="tab-astro">
          <CodeBlock code={astroSnippet} lang="ts" title="Astro" />
        </div>
        <div role="tabpanel" id="panel-next" aria-labelledby="tab-next" hidden>
          <CodeBlock code={nextSnippet} lang="ts" title="Next.js" />
        </div>
      </div>
      <p class="note">Private beta, not yet published. <code>@bakorin/sdk</code> is linked from a checkout today. <a href="/docs/getting-started/">Getting started</a> shows the current path.</p>
    </div>
  </section>

  <section id="faq" class="section">
    <div class="wrap narrow">
      <div class="section-head">
        <p class="kicker">FAQ</p>
        <h2>Questions, answered plainly.</h2>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}{f.link && <> <a href={f.link.href}>{f.link.label}</a>.</>}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section final-cta">
    <div class="wrap narrow center">
      <h2>Your next client backend is one file away.</h2>
      <p>Read the docs, scaffold a project, and sign in to your admin in a few minutes.</p>
      <div class="cta-row center">
        <a class="btn btn-primary" href="/docs/getting-started/">Get started</a>
        <a class="btn btn-ghost" href="/builder/">Build an app.yaml</a>
        <a class="btn btn-ghost" href="/docs/app-yaml/">app.yaml reference</a>
      </div>
    </div>
  </section>

  <script>
    for (const root of document.querySelectorAll<HTMLElement>("[data-tabs]")) {
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const select = (tab: HTMLButtonElement) => {
        for (const t of tabs) {
          const on = t === tab;
          t.setAttribute("aria-selected", String(on));
          t.tabIndex = on ? 0 : -1;
          const panel = document.getElementById(t.getAttribute("aria-controls")!);
          if (panel) panel.hidden = !on;
        }
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener("click", () => select(tab));
        tab.addEventListener("keydown", (e) => {
          if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
          const next = tabs[(i + (e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length];
          select(next);
          next.focus();
        });
      });
    }
  </script>
</Marketing>
