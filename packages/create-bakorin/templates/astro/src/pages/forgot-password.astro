---
import Layout from "../layouts/Base.astro";
import { api } from "../lib/bakorin.ts";

let sent = false;
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  await api(Astro.cookies).forgotPassword({ email: String(form.get("email") ?? "") });
  sent = true;
}
---
<Layout title="Forgot password">
  <section class="card">
    <h1>Forgot password</h1>
    <p class="lede">If that email exists, Bakorin sends a reset link. Check the API logs when MAIL_DRIVER=log.</p>
    {sent ? (
      <div class="banner" role="status">If an account exists for that address, a reset email is on the way.</div>
    ) : (
      <form method="post">
        <label>
          Email
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <div class="actions">
          <button type="submit">Send reset link</button>
          <a href="/login">Back to sign in</a>
        </div>
      </form>
    )}
  </section>
</Layout>
